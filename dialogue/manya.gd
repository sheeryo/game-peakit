extends RefCounted
## Диалоги Мани (арт-маркет). Запуск: Dialogue.start(этот скрипт, "start").
## Порядок веток: знакомство → секретный разговор → после печати / до печати.


func start(d: DialogueBox) -> void:
	if not GameState.has_met("manya"):
		GameState.mark_met("manya")
		# Реликвии и записку уже показала заставка (scenes/ui/intro.gd) — не повторяем
		await d.say("Маня", "Ой, гость! Ты как раз вовремя, солнышко! Капсула пропала, а до открытия всего два часа!")
		await d.say("Маня", "Вот тебе Детективный блокнот и лупа. Теперь ты детектив фестиваля!")
		await d.say("Маня", "Ходи стрелками или WASD, с нашими говори по Enter, а блокнот с печатями и уликами — на Tab.")
		await d.say("Маня", "Загляни ко всем: к Лене на сцену, к Кате на дефиле, к Мойто на конкурсы. И к Сулусу в лекторий, если он не слишком занят.")
		await d.say("Маня", "Помоги каждому, и тебе поставят печать. Три печати, и можно разгадывать тайну!")
		return

	if GameState.has_clue("katya") and not GameState.has_secret("manya_photo"):
		GameState.add_secret_dialogue("manya_photo")
		await d.say("Маня", "Ой, это фото с репетиции? Дай-ка посмотреть…")
		await d.say("Маня", "Рога и фартук… Так фартук только у Сулуса!")
		return

	if GameState.has_stamp("manya"):
		await d.say("Маня", "Ой, солнышко, как продвигается расследование?")
		await d.say("Маня", "Мой эскиз у тебя в блокноте. Ракету за сценой я обвела, как просили.")
		return

	await d.say("Маня", "А копыта у меня в краске, не смотри так! Это с арт-маркета, честное слово.")
	await d.say("Маня", "Ой, беда, солнышко! Я рисовала схему праздника, а ветер разметал кусочки, и всё перепуталось!")
	var answer := await d.ask("Маня", "Поможешь собрать? Стрелками выбирай кусочек, Enter — взять, Enter на другом — поменять местами.",
		["Помогу!", "Потом"])
	if answer == 0:
		GameState.request_minigame("manya")
	else:
		await d.say("Маня", "Ой, хорошо, только возвращайся, солнышко!")
