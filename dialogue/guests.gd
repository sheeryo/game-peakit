extends RefCounted
## Гости фестиваля в хабе: guest_0 … guest_5 (номер — как у спрайта art/characters/guest_N.png).


func guest_0(d: DialogueBox) -> void:
	await d.say("Гостья", "Ого, картонную ракету с «Космоса» опять достали! Стоит за музыкальной сценой, среди планет.")
	await d.say("Гостья", "Я на «Космосе» была в шлеме из коробки. Мама до сих пор его хранит.")


func guest_1(d: DialogueBox) -> void:
	await d.say("Гость", "Я в прошлом году был на «Цирке». Мойто там жонглировал… ну, пытался.")


func guest_2(d: DialogueBox) -> void:
	await d.say("Косплеерша", "Жду дефиле Кати! Говорят, у неё костюмы «Ретро», «Цирк» и «Космос» перепутались.")


func guest_3(d: DialogueBox) -> void:
	await d.say("Гость", "Внимание, вопрос! Хи-хи, это я Мойто передразниваю.")
	await d.say("Гость", "Он с утра что-то прячет за спиной и бегает за кулисы. Подозрительно!")


func guest_4(d: DialogueBox) -> void:
	await d.say("Косплеер", "Ты детектив? Тогда загляни за кулисы музыкальной сцены. Там всегда самое интересное.")
	await d.say("Косплеер", "Вход сбоку от сцены, за красным занавесом.")


func guest_5(d: DialogueBox) -> void:
	await d.say("Гостья", "Сулус с утра насвистывал какую-то мелодию. Обычно он только про гипотезы говорит.")
